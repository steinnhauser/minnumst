# The only .gitignore in the repository; it covers every component.

# Secrets and local configuration
.env
.env.*
.envrc
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
.vault_pass*
*.vault-pass*
vault-password*
# Encrypted or not, real vault files and inventories stay off the repository;
# only the *.example files are tracked.
vault.yml
hosts.ini
host_vars/

# Local databases and dumps
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sql
*.sql.gz
*.dump

# Dependencies, virtual environments and caches
node_modules/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ansible/
.eslintcache
.vite/

# Build, test and coverage output
test-results/
playwright-report/
dist/
build/
coverage/
htmlcov/
.coverage
.coverage.*
*.tsbuildinfo

# Logs and local overrides
*.log
*.local

# OpenTofu: provider cache, plans and per-deployment settings (examples are tracked)
.terraform/
*.tfplan
infra/terraform.tfvars
infra/backend.hcl

# Local Compose stack: rendered configuration and local credentials
tools/compose/.local/
tools/compose/local-vars.yml

# Editors and operating systems
.vscode/*
!.vscode/extensions.json
.idea/
*.sw?
*~
.DS_Store
Thumbs.db
