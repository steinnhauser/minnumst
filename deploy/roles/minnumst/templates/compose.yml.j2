# Rendered by deploy/site.yml (production) and tools/compose/render.yml (local stack).
#
# Networks: only Traefik publishes ports. `edge` connects Traefik to the three
# apps, `backend` (internal, no route out) connects the API to PostgreSQL, and
# `socket` (internal) connects Traefik to the read-only Docker API proxy.
# Authentik's server is on `edge` and `backend`, and its worker on `backend` only.

x-defaults: &defaults
  restart: unless-stopped
  security_opt: ["no-new-privileges:true"]
  logging:
    driver: json-file
    options: { max-size: "10m", max-file: "3" }

x-locked-down: &locked-down
  <<: *defaults
  read_only: true
  cap_drop: [ALL]

# Authentik's server and worker run from one image with the same settings. It
# reports nothing home, and its only outpost is the one built into the server,
# so neither container needs the Docker socket or root as upstream's example has.
x-authentik: &authentik
  <<: *locked-down
  image: {{ authentik_image | to_json }}
  shm_size: 512mb
  environment:
    AUTHENTIK_SECRET_KEY: {{ authentik_secret_key | replace('$', '$$') | to_json }}
    AUTHENTIK_POSTGRESQL__HOST: postgres
    AUTHENTIK_POSTGRESQL__NAME: {{ authentik_database | to_json }}
    AUTHENTIK_POSTGRESQL__USER: {{ authentik_database_user | to_json }}
    AUTHENTIK_POSTGRESQL__PASSWORD: {{ authentik_database_password | to_json }}
    AUTHENTIK_BOOTSTRAP_PASSWORD_HASH: {{ authentik_bootstrap_password_hash | replace('$', '$$') | to_json }}
    AUTHENTIK_LOG_LEVEL: {{ minnumst_log_level | lower | to_json }}
    AUTHENTIK_AVATARS: initials
    AUTHENTIK_DISABLE_UPDATE_CHECK: "true"
    AUTHENTIK_DISABLE_STARTUP_ANALYTICS: "true"
    AUTHENTIK_ERROR_REPORTING__ENABLED: "false"
    AUTHENTIK_WEB__WORKERS: "1"
    MINNUMST_AUTHENTIK_HOST: {{ authentik_domain | to_json }}
    MINNUMST_COOKIE_DOMAIN: {{ authentik_cookie_domain | to_json }}
  tmpfs: [/tmp]
  volumes:
    - authentik_data:/data
  depends_on:
    postgres:
      condition: service_healthy

services:
  traefik:
    <<: *locked-down
    image: {{ traefik_image | to_json }}
    command:
      - --global.checknewversion=false
      - --global.sendanonymoususage=false
      - --log.format=json
      - --api.dashboard=false
      - --providers.docker=true
      - --providers.docker.endpoint=tcp://docker-socket-proxy:2375
      - --providers.docker.exposedbydefault=false
      - --providers.docker.network={{ minnumst_compose_project }}_edge
      - --entrypoints.web.address=:80
      - --entrypoints.web.http.redirections.entrypoint.to=websecure
      - --entrypoints.web.http.redirections.entrypoint.scheme=https
      - --entrypoints.websecure.address=:443
      - --entrypoints.websecure.http.tls=true
      - --entrypoints.websecure.http.middlewares=security-headers@docker
      - --certificatesresolvers.le.acme.email={{ traefik_acme_email }}
      - --certificatesresolvers.le.acme.caserver={{ traefik_acme_ca_server }}
      - --certificatesresolvers.le.acme.storage=/letsencrypt/acme.json
      - --certificatesresolvers.le.acme.httpchallenge.entrypoint=web
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - traefik_acme:/letsencrypt
    depends_on: [docker-socket-proxy]
    networks: [edge, socket]

  # Traefik only needs to list containers and their labels. The proxy exposes
  # that read-only subset of the Docker API, so the edge never holds the socket.
  docker-socket-proxy:
    <<: *locked-down
    image: {{ docker_socket_proxy_image | to_json }}
    environment:
      CONTAINERS: 1
      EVENTS: 1
      PING: 1
      VERSION: 1
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    tmpfs: [/run, /tmp]
    networks: [socket]

  public:
    <<: *locked-down
    image: {{ minnumst_public_image | to_json }}
    environment:
      VITE_API_URL: {{ ("https://" ~ minnumst_api_domain) | to_json }}
      LOG_LEVEL: {{ minnumst_log_level | to_json }}
    labels:
      traefik.enable: "true"
      traefik.http.routers.minnumst-public.rule: "Host(`{{ minnumst_domain }}`)"
      traefik.http.routers.minnumst-public.entrypoints: websecure
      traefik.http.routers.minnumst-public.tls.certresolver: le
      traefik.http.services.minnumst-public.loadbalancer.server.port: "8080"
    networks: [edge]

  admin:
    <<: *locked-down
    image: {{ minnumst_admin_image | to_json }}
    environment:
      VITE_API_URL: {{ ("https://" ~ minnumst_api_domain) | to_json }}
      DEBUG: {{ minnumst_admin_debug | to_json }}
      LOG_LEVEL: {{ minnumst_log_level | to_json }}
    labels:
      traefik.enable: "true"
      traefik.http.routers.minnumst-admin.rule: "Host(`{{ minnumst_admin_domain }}`)"
      traefik.http.routers.minnumst-admin.entrypoints: websecure
      traefik.http.routers.minnumst-admin.tls.certresolver: le
      traefik.http.routers.minnumst-admin.middlewares: authentik@docker
      traefik.http.services.minnumst-admin.loadbalancer.server.port: "8080"
    networks: [edge]

  # Applies the database migrations as the schema owner, then exits. The API
  # starts only after it succeeds, and connects as a role that can't change the
  # schema or rewrite story revisions.
  migrate:
    <<: *locked-down
    restart: "no"
    image: {{ minnumst_api_image | to_json }}
    command: [python, -m, minnumst_api.migrate]
    environment:
      DATABASE_URL: {{ ("postgresql+psycopg://" ~ postgres_migration_user ~ ":" ~ (postgres_migration_password | urlencode) ~ "@postgres:5432/" ~ postgres_database) | to_json }}
      DATABASE_RUNTIME_ROLE: {{ postgres_user | to_json }}
      LOG_LEVEL: {{ minnumst_log_level | to_json }}
    depends_on:
      postgres:
        condition: service_healthy
    networks: [backend]

  api:
    <<: *locked-down
    image: {{ minnumst_api_image | to_json }}
    environment:
      DATABASE_URL: {{ ("postgresql+psycopg://" ~ postgres_user ~ ":" ~ (postgres_password | urlencode) ~ "@postgres:5432/" ~ postgres_database) | to_json }}
      CORS_ORIGINS: {{ ("https://" ~ minnumst_domain ~ ",https://" ~ minnumst_admin_domain) | to_json }}
      LOG_LEVEL: {{ minnumst_log_level | to_json }}
    tmpfs: [/tmp]
    depends_on:
      migrate:
        condition: service_completed_successfully
    labels:
      traefik.enable: "true"
      # Reads are public; every write method goes through Authentik first.
      traefik.http.routers.minnumst-api-read.rule: "Host(`{{ minnumst_api_domain }}`)"
      traefik.http.routers.minnumst-api-read.entrypoints: websecure
      traefik.http.routers.minnumst-api-read.priority: "1"
      traefik.http.routers.minnumst-api-read.tls.certresolver: le
      traefik.http.routers.minnumst-api-read.middlewares: api-ratelimit@docker
      traefik.http.routers.minnumst-api-read.service: minnumst-api
      traefik.http.routers.minnumst-api-write.rule: "Host(`{{ minnumst_api_domain }}`) && (Method(`POST`) || Method(`PUT`) || Method(`PATCH`) || Method(`DELETE`))"
      traefik.http.routers.minnumst-api-write.entrypoints: websecure
      traefik.http.routers.minnumst-api-write.priority: "100"
      traefik.http.routers.minnumst-api-write.tls.certresolver: le
      traefik.http.routers.minnumst-api-write.middlewares: api-ratelimit@docker,authentik@docker
      traefik.http.routers.minnumst-api-write.service: minnumst-api
      traefik.http.services.minnumst-api.loadbalancer.server.port: "8000"
      # Shared middlewares, defined once here and referenced by every router.
      traefik.http.middlewares.authentik.forwardauth.address: {{ authentik_forwardauth_address | to_json }}
      # Traefik is the edge and drops client-sent X-Forwarded-* headers, so only
      # its own reach Authentik.
      traefik.http.middlewares.authentik.forwardauth.trustForwardHeader: "true"
      traefik.http.middlewares.api-ratelimit.ratelimit.average: "20"
      traefik.http.middlewares.api-ratelimit.ratelimit.burst: "50"
      traefik.http.middlewares.security-headers.headers.stsSeconds: "63072000"
      traefik.http.middlewares.security-headers.headers.stsIncludeSubdomains: "true"
      traefik.http.middlewares.security-headers.headers.contentTypeNosniff: "true"
      traefik.http.middlewares.security-headers.headers.frameDeny: "true"
      traefik.http.middlewares.security-headers.headers.referrerPolicy: strict-origin-when-cross-origin
    networks: [edge, backend]

  authentik-server:
    <<: *authentik
    command: server
    labels:
      traefik.enable: "true"
      traefik.http.routers.authentik.rule: "Host(`{{ authentik_domain }}`)"
      traefik.http.routers.authentik.entrypoints: websecure
      traefik.http.routers.authentik.tls.certresolver: le
      traefik.http.routers.authentik.middlewares: authentik-ratelimit@docker
      traefik.http.services.authentik.loadbalancer.server.port: "9000"
      # A login page loads many assets at once, so this burst is larger than the API's.
      traefik.http.middlewares.authentik-ratelimit.ratelimit.average: "50"
      traefik.http.middlewares.authentik-ratelimit.ratelimit.burst: "200"
    networks: [edge, backend]

  authentik-worker:
    <<: *authentik
    command: worker
    configs:
      - source: authentik-blueprint
        target: /blueprints/custom/minnumst.yaml
    networks: [backend]

  postgres:
    # Runs as the image's unprivileged postgres user (uid 70), so the entrypoint
    # needs no root and no capabilities. Every connection uses SCRAM-SHA-256.
    <<: *locked-down
    image: {{ postgres_image | to_json }}
    user: "70:70"
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: {{ postgres_superuser_password | to_json }}
      POSTGRES_DB: {{ postgres_database | to_json }}
      POSTGRES_INITDB_ARGS: --auth-local=scram-sha-256 --auth-host=scram-sha-256
      MINNUMST_MIGRATION_USER: {{ postgres_migration_user | to_json }}
      MINNUMST_MIGRATION_PASSWORD: {{ postgres_migration_password | to_json }}
      MINNUMST_APP_USER: {{ postgres_user | to_json }}
      MINNUMST_APP_PASSWORD: {{ postgres_password | to_json }}
      MINNUMST_AUTHENTIK_DATABASE: {{ authentik_database | to_json }}
      MINNUMST_AUTHENTIK_USER: {{ authentik_database_user | to_json }}
      MINNUMST_AUTHENTIK_PASSWORD: {{ authentik_database_password | to_json }}
    configs:
      - source: postgres-roles
        target: /docker-entrypoint-initdb.d/roles.sh
    volumes:
      - postgres_data:/var/lib/postgresql
    tmpfs: [/var/run/postgresql, /tmp]
    healthcheck:
      test: ["CMD", "pg_isready", "--username", "postgres", "--dbname", {{ postgres_database | to_json }}]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s
    networks: [backend]

# roles/minnumst/files/postgres-roles.sh, installed next to this file, creates
# the database roles when the data directory is first created. The blueprint
# next to it holds Authentik's configuration.
configs:
  postgres-roles:
    file: ./postgres-roles.sh
  authentik-blueprint:
    file: ./authentik-blueprint.yaml

volumes:
  authentik_data:
  postgres_data:
  traefik_acme:

networks:
  edge:
  backend:
    internal: true
  socket:
    internal: true
