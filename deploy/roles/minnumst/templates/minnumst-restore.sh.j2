#!/bin/bash
# Managed by Ansible (deploy/roles/minnumst). Restores a pg_dump custom-format
# file, replacing the database. Decrypt an encrypted backup first, off the host:
#   age --decrypt --identity key.txt minnumst-....dump.age > minnumst.dump
set -euo pipefail
[[ $# -eq 1 && -f $1 ]] || { echo "Usage: $0 <decrypted backup.dump>" >&2; exit 2; }

compose=(docker compose --project-name {{ minnumst_compose_project | quote }} --file {{ (minnumst_deploy_dir ~ '/compose.yml') | quote }})
read -rp "This replaces the production database with $1. Type 'restore' to continue: " answer
[[ $answer == restore ]] || { echo "Cancelled." >&2; exit 1; }

"${compose[@]}" stop api
"${compose[@]}" exec -T postgres sh -c \
  'PGPASSWORD="$POSTGRES_PASSWORD" pg_restore --username postgres --dbname "$POSTGRES_DB" --clean --if-exists --exit-on-error' < "$1"
"${compose[@]}" up --detach api
echo "Restored $1."
