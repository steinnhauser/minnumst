#!/bin/bash
# Managed by Ansible (deploy/roles/minnumst). Restores a pg_dump custom-format
# file, replacing a database: the archive's, or Authentik's with "authentik" as the
# second argument. Decrypt an encrypted backup first, off the host:
#   age --decrypt --identity key.txt minnumst-....dump.age > minnumst.dump
set -euo pipefail
[[ ($# -eq 1 || ($# -eq 2 && $2 == authentik)) && -f $1 ]] || { echo "Usage: $0 <decrypted backup.dump> [authentik]" >&2; exit 2; }

if [[ ${2:-} == authentik ]]; then
  database={{ authentik_database | quote }}
  services=(authentik-server authentik-worker)
else
  database={{ postgres_database | quote }}
  services=(api)
fi

compose=(docker compose --project-name {{ minnumst_compose_project | quote }} --file {{ (minnumst_deploy_dir ~ '/compose.yml') | quote }})
read -rp "This replaces the production database $database with $1. Type 'restore' to continue: " answer
[[ $answer == restore ]] || { echo "Cancelled." >&2; exit 1; }

"${compose[@]}" stop "${services[@]}"
"${compose[@]}" exec -T -e DATABASE="$database" postgres sh -c \
  'PGPASSWORD="$POSTGRES_PASSWORD" pg_restore --username postgres --dbname "$DATABASE" --clean --if-exists --exit-on-error' < "$1"
"${compose[@]}" up --detach "${services[@]}"
echo "Restored $1 into $database."
