# Minnumst from commit to running host.
# Source of docs/assets/diagram-delivery.svg; run `make diagrams` after editing.
vars: {
  ...@palette
  d2-config: {
    layout-engine: elk
    pad: 24
  }
}
classes: {
  ...@classes
  gate: {style: {font-size: 20; fill: ${solid}; stroke: ${solid}; font-color: ${on-solid}; bold: true; border-radius: 8}}
}
style.fill: ${canvas}
(** -> **)[*].style: {stroke: ${ink}; font-color: ${muted}; font-size: 18}

direction: down

repo: One monorepo {
  class: area
  code: "api/ web/ admin/\npackages/ docker/" {class: part}
  infra: "infra/\nOpenTofu" {class: part}
  deploy: "deploy/\nAnsible + vault" {class: part}
}

tag: "make release\ncomponent tag" {class: auth; shape: oval}

ci: GitHub Actions · ci.yml {
  class: area
  gates: On every push and pull request {
    class: internal
    grid-columns: 2
    grid-gap: 12
    checks: "checks\nlint · OpenAPI · builds" {class: step}
    tests: "tests\n100% coverage" {class: step}
    e2e: "e2e\nfull stack · Trivy" {class: step}
    codeql: "codeql\nsecurity scan" {class: step}
  }
  host: "host\nhardening · Lynis" {class: step}
  ok: "ci-ok\nrequired check" {class: gate}
  release: "release\non a tag only" {class: gate}

  gates -> ok
  host -> ok
  gates -> release
}

ghcr: "GHCR images\namd64 + arm64\nprovenance · SBOM" {class: store}
ghrel: "GitHub Release\nchangelog" {class: result}
cloud: "Hetzner Cloud\nserver · firewall\nvolume · DNS" {class: result}
server: "Hardened host\nhost → docker → minnumst" {class: result}

repo.code -> ci.gates
tag -> ci.release
ci.release -> ghcr
ci.release -> ghrel
repo.infra -> cloud: make infra apply
cloud -> server
repo.deploy -> server: make deploy
ghcr -> server: "pulled by\npinned digest" {style.stroke-dash: 3}
