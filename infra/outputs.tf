output "ipv4_address" {
  description = "Point the A records of the three hostnames here."
  value       = hcloud_server.host.ipv4_address
}

output "ipv6_address" {
  description = "Point the AAAA records of the three hostnames here."
  value       = hcloud_server.host.ipv6_address
}

# `make infra-inventory` writes this to deploy/inventory/hosts.ini.
output "ansible_inventory" {
  description = "The Ansible inventory for this server."
  value       = <<-EOT
    # Generated by `make infra-inventory` from infra/; don't edit by hand.
    [minnumst]
    server ansible_host=${hcloud_server.host.ipv4_address} ansible_user=${var.admin_user} host_data_device=${hcloud_volume.data.linux_device}
  EOT
}
